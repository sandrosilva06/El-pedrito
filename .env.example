# ---------------------------------------------------------------------------
# Servidor
# ---------------------------------------------------------------------------
# Porta HTTP do servidor Express.
PORT=3000
# development | production
NODE_ENV=development
# debug | info | warn | error
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Telegram
# ---------------------------------------------------------------------------
# Token obtido com o @BotFather.
TELEGRAM_BOT_TOKEN=123456789:AAExemploDeTokenDoBotFather

# Modo de recebimento de updates. Deixe VAZIO para decidir sozinho: havendo
# URL publica (abaixo, ou RENDER_EXTERNAL_URL que o Render injeta) usa
# "webhook"; sem ela, "polling". Preencha so para forcar um dos dois.
#
# Cuidado com "polling" em plataforma que hiberna por inatividade: o servico
# dorme, ninguem faz polling, e nada volta a acorda-lo — o bot fica mudo.
TELEGRAM_MODE=

# URL publica HTTPS da aplicacao, sem barra no final (barra final e removida).
# No Render nao precisa: RENDER_EXTERNAL_URL ja e detectada.
# Ex.: https://el-pedrito.onrender.com
TELEGRAM_WEBHOOK_URL=

# Segredo do header X-Telegram-Bot-Api-Secret-Token. Opcional: sem ele um
# valor estavel e derivado do proprio token do bot. Preencha (16+ caracteres,
# via `openssl rand -hex 32`) se quiser tambem liberar o GET /stats, que so
# funciona com segredo configurado a mao.
TELEGRAM_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Gemini — uma unica chave serve os dois papeis da cadeia
# ---------------------------------------------------------------------------
GEMINI_API_KEY=

# Estrategista: le o historico e decide a diretriz de vendas.
# (GEMINI_MODEL e o nome antigo desta variavel e continua a ser aceite.)
GEMINI_STRATEGIST_MODEL=gemini-3.6-flash

# Redator: transforma a diretriz na mensagem que o lead recebe.
# Mantenha-o DIFERENTE do estrategista: a quota gratuita e contada por modelo
# e a cadeia gasta duas chamadas por mensagem. Iguais, o teto cai pela metade.
GEMINI_WRITER_MODEL=gemini-3.5-flash
GEMINI_WRITER_MAX_TOKENS=700

# Nao use gemini-1.5-flash nem 2.0-flash: foram retirados e respondem 404.
# `npx tsx scripts/models.ts` lista os modelos que a sua chave serve.

# ---------------------------------------------------------------------------
# Persistencia
# ---------------------------------------------------------------------------
# Caminho do arquivo SQLite. Use ":memory:" para testes.
DATABASE_PATH=./data/funnel.sqlite
# Quantas mensagens recentes sao enviadas como memoria para as IAs.
HISTORY_WINDOW=20

# ---------------------------------------------------------------------------
# Negocio / Funil
# ---------------------------------------------------------------------------
# Nome da persona que assina as mensagens.
AGENT_NAME=Pedrito
# Nome da plataforma de afiliados divulgada.
PLATFORM_NAME=Minha Plataforma
# Link de afiliado usado nas chamadas para acao.
AFFILIATE_LINK=https://exemplo.com/?ref=meucodigo
# Bonus/oferta corrente mencionada no funil.
CURRENT_OFFER=Bonus de boas-vindas no primeiro deposito
# Deposito minimo comunicado ao lead.
MIN_DEPOSIT=R$ 20

# Idade minima exigida e aviso obrigatorio anexado as ofertas.
MIN_AGE=18
COMPLIANCE_NOTE=Conteudo para maiores de 18 anos. Invista/aposte apenas o que puder perder.

# ---------------------------------------------------------------------------
# Rate limiting (por chat_id)
# ---------------------------------------------------------------------------
# Numero maximo de mensagens processadas por chat dentro da janela.
RATE_LIMIT_MAX=12
# Janela do rate limit, em segundos.
RATE_LIMIT_WINDOW_SECONDS=60

# Lista opcional de chat_ids (separados por virgula) com acesso aos comandos
# administrativos (/stats). Vazio = comandos admin desativados.
ADMIN_CHAT_IDS=
