# ---------------------------------------------------------------------------
# Servidor
# ---------------------------------------------------------------------------
# Porta HTTP do servidor Express.
PORT=3000
# development | production
NODE_ENV=development
# debug | info | warn | error
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Telegram
# ---------------------------------------------------------------------------
# Token obtido com o @BotFather.
TELEGRAM_BOT_TOKEN=123456789:AAExemploDeTokenDoBotFather

# Modo de recebimento de updates. Deixe VAZIO: havendo URL publica (abaixo, ou
# RENDER_EXTERNAL_URL que o Render injeta) usa "webhook"; sem ela, "polling".
#
# Em NODE_ENV=production com URL publica o webhook e IMPOSTO, mesmo que aqui
# esteja "polling" — numa plataforma que hiberna por inatividade o polling
# nunca volta depois do primeiro spin-down e o bot fica mudo sem erro nenhum.
TELEGRAM_MODE=

# URL publica HTTPS da aplicacao, sem barra no final (barra final e removida).
# No Render nao precisa: RENDER_EXTERNAL_URL ja e detectada.
# Ex.: https://el-pedrito.onrender.com
TELEGRAM_WEBHOOK_URL=

# Caminho registrado no Telegram. Default: /webhook. O caminho derivado do
# token (/telegram/<cauda>) continua aceito, para nao quebrar um webhook ja
# registrado nele.
TELEGRAM_WEBHOOK_PATH=

# Segredo do header X-Telegram-Bot-Api-Secret-Token. Opcional: sem ele um
# valor estavel e derivado do proprio token do bot. Preencha (16+ caracteres,
# via `openssl rand -hex 32`) se quiser tambem liberar o GET /stats, que so
# funciona com segredo configurado a mao.
TELEGRAM_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Gemini — uma unica chave serve os dois papeis da cadeia
# ---------------------------------------------------------------------------
GEMINI_API_KEY=

# Estrategista: le o historico e decide a diretriz de vendas.
# (GEMINI_MODEL e o nome antigo desta variavel e continua a ser aceite.)
GEMINI_STRATEGIST_MODEL=gemini-3.6-flash

# Redator: transforma a diretriz na mensagem que o lead recebe.
# Mantenha-o DIFERENTE do estrategista: a quota gratuita e contada por modelo
# e a cadeia gasta duas chamadas por mensagem. Iguais, o teto cai pela metade.
GEMINI_WRITER_MODEL=gemini-3.5-flash
GEMINI_WRITER_MAX_TOKENS=700

# Nao use gemini-1.5-flash nem 2.0-flash: foram retirados e respondem 404.
# `npx tsx scripts/models.ts` lista os modelos que a sua chave serve.

# ---------------------------------------------------------------------------
# Persistencia
# ---------------------------------------------------------------------------
# Caminho do arquivo SQLite. Use ":memory:" para testes.
DATABASE_PATH=./data/funnel.sqlite
# Quantas mensagens recentes sao enviadas como memoria para as IAs.
HISTORY_WINDOW=20

# ---------------------------------------------------------------------------
# Negocio / Funil
# ---------------------------------------------------------------------------
# Estes valores entram nos prompts das duas IAs. O bot diz exatamente o que
# estiver aqui, por isso confirma antes de falar com leads a serio.

# Nome com que o atendente se apresenta.
AGENT_NAME=Pedrito

# O produto desta fase: o grupo VIP que o funil promove.
GROUP_NAME=El Pedrito Tips
TARGET_AUDIENCE=portugueses emigrantes na Suica

# Casa onde o lead faz registo e deposito para desbloquear o grupo. Nao e
# divulgada como produto: e so a porta de entrada.
PLATFORM_NAME=GangstaSino
AFFILIATE_LINK=

# Deposito minimo. Fica como saldo do proprio lead, nao e pagamento ao grupo.
MIN_DEPOSIT=20€

# Entradas desportivas enviadas por dia no grupo.
TIPS_PER_DAY=8

# Prova social. Sao afirmacoes de facto sobre resultados, ditas ao lead tal e
# qual antes de lhe ser pedido o deposito — por isso ficam aqui, em vez de
# fixas no prompt: poe apenas o que consigas sustentar se te pedirem provas.
# O redator tem instrucao de nunca inventar numeros; com estas vazias, fala de
# assertividade sem citar valores.
HIT_RATE_CLAIM=no ultimo Mundial batemos 30 greens seguidos
PAYOUT_CLAIM=a malta ja levantou mais de 300.000€ da plataforma

# Argumentos de confianca na plataforma, usados para tratar a objecao de quem
# ja tem conta noutra casa. Mesma regra dos numeros: o bot repete isto tal e
# qual ao lead, por isso poe apenas o que consigas sustentar.
PLATFORM_TRUST_CLAIM=e das melhores a operar na Suica, com odds fortes e levantamentos rapidos

# Valor aconselhado (nao exigido) para acompanhar as entradas do dia.
SUGGESTED_DEPOSIT=50€

MIN_AGE=18
COMPLIANCE_NOTE=Conteudo para maiores de 18 anos. Aposta apenas o que podes perder.

# ---------------------------------------------------------------------------
# Ritmo de chat
# ---------------------------------------------------------------------------
# A resposta e entregue em varias mensagens curtas, com "a escrever..." antes
# de cada uma. Um bloco unico entregue de golpe denuncia o bot mais depressa
# que qualquer erro de portugues.
MAX_BUBBLES=4

# Duracao do "a escrever..." antes de cada mensagem (ms). Com 4 mensagens, a
# resposta completa demora ~35s a sair — e o preco do ritmo humano.
TYPING_MS_MIN=7000
TYPING_MS_MAX=8000

# Pausa depois de enviar, antes de comecar a escrever a seguinte (ms).
BUBBLE_PAUSE_MS_MIN=1000
BUBBLE_PAUSE_MS_MAX=2000

# ---------------------------------------------------------------------------
# Remarketing automatico
# ---------------------------------------------------------------------------
# "false" desliga por completo o envio automatico.
REMARKETING_ENABLED=true

# Horarios dos envios, no fuso abaixo (o dos leads, nao o do servidor).
REMARKETING_SLOTS=09:30,14:30,20:30
REMARKETING_TIMEZONE=Europe/Zurich

# Quantos lembretes um lead que nao converteu recebe no total antes de o bot se
# calar. Quem nao respondeu ao segundo tambem nao responde ao decimo: so
# bloqueia o bot, e bloqueios em massa fazem o Telegram limitar a conta.
#
# So ha guiao escrito para dois toques, por isso o codigo trava aqui em 2 mesmo
# que puseres um numero maior. Um terceiro sairia sem texto proprio.
REMARKETING_MAX_TOUCHES=2

# Silencio necessario antes do PRIMEIRO toque, contado desde a ultima coisa que
# o lead disse.
REMARKETING_FIRST_TOUCH_HOURS=24

# Intervalo entre o primeiro e o segundo toque. Com 24 + 48 o segundo cai as 72h
# de silencio.
REMARKETING_SECOND_TOUCH_HOURS=48

# Pausa entre envios dentro da mesma campanha. O Telegram limita a ~30 mensagens
# por segundo e responde a rajadas com 429.
REMARKETING_SEND_INTERVAL_MS=120

# Horas de silencio apos a ultima atividade do lead, usado no publico VIP. A
# quem falou connosco ha pouco nao se manda um lembrete automatico, responde-se.
REMARKETING_QUIET_HOURS=20

# ---------------------------------------------------------------------------
# Rate limiting (por chat_id)
# ---------------------------------------------------------------------------
# Numero maximo de mensagens processadas por chat dentro da janela.
RATE_LIMIT_MAX=12
# Janela do rate limit, em segundos.
RATE_LIMIT_WINDOW_SECONDS=60

# Destinos (separados por virgula) para onde os comprovativos sao
# reencaminhados, e que podem usar /stats. Aceita ids de pessoa e de
# grupo/canal (estes sao negativos, como -1004453145425).
#
# O bot tem de pertencer ao grupo/canal e ter permissao para publicar la —
# senao o print e guardado na base de dados mas nao chega a ninguem, e o log
# grita isso no arranque de cada envio.
#
# Se apagares esta variavel, o codigo usa o canal por omissao. Descobre um id
# de pessoa com o @userinfobot.
ADMIN_CHAT_IDS=-1004453145425
